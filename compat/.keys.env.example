# 复制为 compat/.keys.env 后填入，全部可选。
# 没有 key 也能跑，只是少几个数据源、置信度降低。
#
# IPQS          免费 1000 次/月（每日上限 35）   https://www.ipqualityscore.com/create-account
# AbuseIPDB     免费 1000 次/天                 https://www.abuseipdb.com/register
# VirusTotal    免费 500 次/天（4 次/分）        https://www.virustotal.com/gui/join-us

IPQS_KEY=
ABUSEIPDB_KEY=
VIRUSTOTAL_KEY=
