def _print_probe(ip, probe, platforms):
    """实测结果 + 与推断的逐项对照。不一致比一致更有信息量。"""
    print()
    print("【实测验证】经 %s 出站" % probe["proxy"])
    if probe.get("error"):
        print("  ✘ 出口校验失败：%s" % probe["error"])
        print("  请确认代理客户端已启动、端口正确、且开了 socks5 监听")
        return
    if not probe.get("match"):
        print("  ✘ 出口 IP 是 %s，与目标 %s 不一致 —— 拒绝实测"
              % (probe["exit_ip"], ip))
        print("  风控只看请求从哪个 IP 来。出口不一致时，测到的是你自己的网络，")
        print("  和这个 IP 毫无关系。请先在客户端切到该 IP 对应的节点再重跑。")
        return
    print("  ✔ 出口 IP %s，与目标一致" % probe["exit_ip"])
    print()

    pmap = {p["key"]: p for p in (platforms or {}).get("platforms", [])}
    print("  " + pad("平台", 22) + pad("实测", 7) + pad("耗时", 7)
          + pad("推断", 7) + pad("对照", 10) + "证据")
    print("  " + "-" * 78)
    agree = differ = 0
    seen = set()
    for r in probe["results"]:
        p = pmap.get(r.get("key"))
        guess = p["verdict"] if p else "—"
        align = "—"
        if p and r.get("key") in seen:
            align = "同平台"          # 同一平台多个探针，只算一次对照
        elif p:
            seen.add(r.get("key"))
            if (r["verdict"] == "通过") == (guess == "通过"):
                align, agree = "一致", agree + 1
            elif r["verdict"] == "通过":
                align, differ = "推断偏严", differ + 1
            elif guess == "通过":
                align, differ = "推断偏松", differ + 1
            else:
                align, differ = "待观察", differ + 1
        try:
            cost = "%.1fs" % float(r["elapsed"])
        except Exception:
            cost = "—"
        print("  " + pad(r["name"], 22) + pad(r["verdict"], 7) + pad(cost, 7)
              + pad(guess, 7) + pad(align, 10) + r["evidence"])
    print("  " + "-" * 78)
    print("  一致 %d 项 ｜ 偏差 %d 项。风控是概率性的：单次通过不代表稳定通过，"
          % (agree, differ))
    print("  单次被拦也不代表永久封禁，间隔几分钟再测 2-3 次更可靠。")


