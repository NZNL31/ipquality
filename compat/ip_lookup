def _print_score(sc):
    """把评分结果渲染成人能一眼看懂的分块。"""
    total = sc["score"]
    filled = int(round(total / 5.0))
    bar = "█" * filled + "░" * max(0, 20 - filled)
    print()
    print("【综合评分】 %d / 100    等级 %s · %s    置信度 %d%%"
          % (total, sc["grade"], sc["grade_cn"], sc["confidence"]))
    print("  " + bar)
    print("  " + sc["verdict"])
    if sc.get("cap"):
        print("  （线性扣分原始值 %.1f 分，因「%s」触发上限 %d 分）"
              % (sc["raw_score"], sc["cap_reason"], sc["cap"]))
    print()
    print("  " + pad("维度", 18) + pad("权重", 6, ">") + pad("得分", 6, ">")
          + pad("扣分", 8, ">") + "  依据")
    print("  " + "-" * 78)
    for d in sc["dimensions"]:
        penalty = "-%.1f" % d["penalty"] if d["penalty"] else "0.0"
        print("  " + pad(d["name"], 18) + pad(d["weight"], 6, ">")
              + pad("%.1f" % d["score"], 6, ">") + pad(penalty, 8, ">")
              + "  " + d["evidence"])


