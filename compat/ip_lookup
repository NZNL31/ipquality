          + "  预判")
    print("  " + "-" * 72)
    for r in rows:
        print("  " + pad(r["name"], 35) + pad(r["sensitive"], 11)
              + pad(r["trust"], 8, ">")
              + "  %s %s" % (VERDICT_MARK.get(r["verdict"], "·"), r["verdict"]))
    print("  " + "-" * 72)
    blocked = [r for r in rows if r["verdict"] in ("挑战", "拒绝")]
