def intel_virustotal(ip):
    """VirusTotal：90+ 引擎判定 + 社区信誉（需 key，免费 500 次/天、4 次/分）。"""
    key = KEYS["virustotal"]
    if not key:
        return None
    d = fetch_json("https://www.virustotal.com/api/v3/ip_addresses/%s" % ip, 25,
                   {"x-apikey": key})
    if d.get("error"):
        code = (d.get("error") or {}).get("code") or "错误"
        return {"name": "VirusTotal", "note": "查询失败（%s）" % code}
    attrs = (d.get("data") or {}).get("attributes") or {}
    if not attrs:
        return {"name": "VirusTotal", "note": "无响应"}
    stats = attrs.get("last_analysis_stats") or {}
    mal = int(stats.get("malicious") or 0)
    sus = int(stats.get("suspicious") or 0)
    total = sum(int(v or 0) for v in stats.values()) or 0
    rep = attrs.get("reputation")
    bits = ["恶意 %d/%d 引擎" % (mal, total)]
    if sus:
        bits.append("可疑 %d" % sus)
    bits.append("信誉 %s" % ("—" if rep is None else rep))
    flagged = sorted(n for n, r in (attrs.get("last_analysis_results") or {}).items()
                     if r.get("category") in ("malicious", "suspicious"))
    if flagged:
        bits.append("检出 %s%s" % (",".join(flagged[:5]),
                                   "" if len(flagged) <= 5 else " 等"))
    tags = [t for t in (attrs.get("tags") or []) if t and not t.isdigit()]
    if tags:
        bits.append("标签 %s" % ",".join(tags[:5]))
    owner = (attrs.get("as_owner") or "").strip()
    if owner:
        bits.append("AS %s %s" % (attrs.get("asn") or "", owner))
    return {"name": "VirusTotal", "note": " | ".join(bits),
            "warn": mal > 0 or sus > 0, "_tags": [t.lower() for t in tags],
            "_mal": mal, "_sus": sus, "_total": total, "_rep": rep}


def intel_pdns(ip):
    """被动 DNS：这个出口近期承载了多少域名 —— 共享度，滥用风险的关键变量。

    独享出口的信誉只由自己的行为决定；高密度共享出口则一损俱损，
    同一出口上任何一个域名作恶，整段出口的风控评级都会被拖低。
    数据来自 VirusTotal resolutions（meta.count 为累计总数，
    免费层每次最多返回 40 条，recent 只能按返回样本统计）。
    """
    key = KEYS["virustotal"]
    if not key:
        return None
    d = fetch_json(
        "https://www.virustotal.com/api/v3/ip_addresses/%s/resolutions?limit=40"
        % ip, 25, {"x-apikey": key})
    if d.get("error"):
        code = (d.get("error") or {}).get("code") or "错误"
        return {"name": "PassiveDNS", "note": "查询失败（%s）" % code}
    total_all = int((d.get("meta") or {}).get("count") or 0)
    items = d.get("data") or []
    now = time.time()
    recent = 0
    mal_hosts = []
    hosts = []
    for it in items:
        a = it.get("attributes") or {}
        host = (a.get("host_name") or "").strip()
        if not host:
            continue
        hosts.append(host)
        ts = a.get("date") or 0
        if ts and (now - ts) <= 90 * 86400:
            recent += 1
        st = a.get("host_name_last_analysis_stats") or {}
        if int(st.get("malicious") or 0) > 0:
            mal_hosts.append(host)
    if not hosts:
        return {"name": "PassiveDNS",
                "note": "近 90 天没有域名解析到此（基本独享的出口）",
                "warn": False,
                "_recent": 0, "_total": total_all, "_hosts": [], "_mal_hosts": []}
    bits = ["近 90 天活跃 %d 个域名" % recent]
    if total_all > len(items):
        bits.append("累计 %d 条（样本前 %d 条）" % (total_all, len(items)))
    if mal_hosts:
        bits.append("⚠ %d 个共用域名被引擎判恶意" % len(mal_hosts))
    bits.append("例 %s" % "、".join(hosts[:3]))
    return {"name": "PassiveDNS", "note": " | ".join(bits),
            "warn": bool(mal_hosts) or recent >= 30,
            "_recent": recent, "_total": total_all,
            "_hosts": hosts, "_mal_hosts": mal_hosts}


