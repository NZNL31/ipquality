def src_proxycheck(ip):
    d = fetch_json("https://proxycheck.io/v2/%s?vpn=1&asn=1" % ip, 15)
    if not d or d.get("status") != "ok":
        return {"name": "proxycheck.io", "proxy": None, "vpn": None, "tor": None,
                "hosting": None, "mobile": None, "score": None,
                "_err": (d.get("message") or "限额/不可用") if d else "不可用"}
    node = d.get(ip) or next((v for k, v in d.items()
                              if isinstance(v, dict) and k != "status"), {})
    ptype = (node.get("type") or "").strip()
    ptype_raw = ptype
    if ptype.lower() in ("residential", "business", ""):
        ptype = ""
    return {
        "name": "proxycheck.io",
        "proxy": yn(node.get("proxy")),
        "vpn": None, "tor": None,
        "hosting": None, "mobile": None,
        "score": None,
        "_rtype": ptype,
        "_ptype": ptype_raw,
        "_geo": (node.get("country"), node.get("region"), node.get("city")),
        "_org": node.get("organisation") or node.get("provider"),
    }


def src_scamalytics(ip):
    html = fetch("https://scamalytics.com/ip/%s" % ip, 18)
    if not html or "Fraud Score" not in html:
        return None
    m = re.search(r"Fraud Score[^0-9]{0,60}(\d{1,3})", html)
    score = int(m.group(1)) if m else None
    proxy = None
    mp = re.search(r"Anonymous Proxy[^A-Za-z]{0,20}(Yes|No)", html, re.I)
    if mp:
        proxy = mp.group(1).lower() == "yes"
    tor = None
    mt = re.search(r"Tor Exit Node[^A-Za-z]{0,20}(Yes|No)", html, re.I)
    if mt:
        tor = mt.group(1).lower() == "yes"
    return {"name": "Scamalytics", "proxy": proxy, "vpn": None, "tor": tor,
            "hosting": None, "mobile": None, "score": score}


