def _special_scope(ip):
    """私有/保留地址没有公网信誉。给它打分只会误导，必须显式拒绝。"""
    try:
        a = ipaddress.ip_address(ip)
    except ValueError:
        return "不是合法的 IP 地址（IPv4 形如 1.2.3.4，IPv6 含冒号）"
    for net, msg in _SPECIAL:
        if a.version == net.version and a in net:
            return msg
    return None


def tri(value):
    if value is None:
        return "—"
    return "是" if value else "否"


def wlen(text):
    """按终端显示宽度算长度：中日韩全角字符占 2 列。"""
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1
               for c in str(text))


def pad(text, width, align="<"):
    """按显示宽度补齐，保证中英混排的表格列对齐。"""
    text = str(text)
    gap = width - wlen(text)
    if gap <= 0:
        return text
    return text + " " * gap if align == "<" else " " * gap + text


# ---------------------------------------------------------------- DNSBL
def nameservers():
    try:
        with open(os.path.join(HERE, ".ns_cache.json"), "r", encoding="utf-8") as fh:
            ns = json.load(fh).get("ns")
            if ns:
                return ns
    except Exception:
        pass
    try:
        return list(dns.resolver.Resolver().nameservers)
    except Exception:
        return ["223.5.5.5"]


NS = nameservers()


def load_zones():
    fresh = False
    if os.path.exists(DNSBL_LIST):
        fresh = time.time() - os.path.getmtime(DNSBL_LIST) < LIST_TTL
    if not fresh:
        text = fetch(DNSBL_URL, 20)
        zones = sorted({line.strip() for line in text.splitlines()
                        if line.strip() and not line.strip().startswith("#")})
        if zones:
            try:
                with open(DNSBL_LIST, "w", encoding="utf-8") as fh:
                    fh.write("\n".join(zones) + "\n")
            except Exception:
                pass
            return zones
    try:
        with open(DNSBL_LIST, "r", encoding="utf-8", errors="replace") as fh:
            return sorted({line.strip() for line in fh if line.strip()})
    except Exception:
        return []


def classify(job):
    zone, query_name = job
    resolver = dns.resolver.Resolver(configure=False)
    resolver.nameservers = NS
    resolver.timeout = 1.5
    resolver.lifetime = 3.0
    resolver.retry_servfail = False
    try:
        answer = resolver.resolve(query_name, "A", raise_on_no_answer=False)
        if answer.rrset is None:
            return zone, "clean", None
        addresses = [rr.address for rr in answer]
    except Exception:
        return zone, "clean", None
    if not addresses:
        return zone, "clean", None
    if "127.0.0.2" in addresses:
        return zone, "blacklisted", addresses
    if all(a.startswith("127.255.255.") for a in addresses):
        return zone, "clean", None
    return zone, "other", addresses


SENTINELS = ("8.8.8.8", "1.1.1.1")


def zone_untrusted(zone):
    """该库若对公认干净的公共 DNS 也报黑名单，说明应答不可信（需注册/配置错误）。"""
    for sentinel in SENTINELS:
        rev = ".".join(reversed(sentinel.split(".")))
        verdict = classify((zone, "%s.%s" % (rev, zone)))[1]
        if verdict != "clean":
            return True
    return False


def dnsbl_report(ip, zones, jobs=40):
    reversed_ip = ".".join(reversed(ip.split(".")))
    result = {"total": 0, "clean": 0, "other": 0, "blacklisted": 0,
              "suspect": 0, "hits": []}
    jobs_list = [(z, "%s.%s" % (reversed_ip, z)) for z in zones]
    with ThreadPoolExecutor(max_workers=jobs) as pool:
        for zone, verdict, addrs in pool.map(classify, jobs_list):
            result["total"] += 1
            result[verdict] += 1
            if verdict != "clean":
                result["hits"].append({"zone": zone, "verdict": verdict,
                                       "answer": addrs or []})
    result["hits"].sort(key=lambda h: (h["verdict"] != "blacklisted", h["zone"]))
    # 复核：命中即意味着「该库把这个 IP 列进去了」。
    # 但部分库（需注册的、或分区配置错误的）对所有查询都返回 127.0.0.2，
    # 用两个公认干净的 IP 反查一次即可识别这类误报。
    if result["hits"]:
        with ThreadPoolExecutor(max_workers=8) as pool:
            for hit in result["hits"]:
                hit["suspect"] = pool.submit(zone_untrusted, hit["zone"]).result()
        for hit in result["hits"]:
            if hit.get("suspect"):
                result[hit["verdict"]] -= 1
                result["suspect"] += 1
    return result


