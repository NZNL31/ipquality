    }


def check_drop(ip):
    """Spamhaus DROP：被劫持/攻击用途的网段清单，本地匹配。"""
    try:
        addr = ipaddress.ip_address(ip)
    except Exception:
        return "skip", None
    if addr.version != 4:
        return "skip", None
    need_fetch = True
    if os.path.exists(DROP_LIST) and time.time() - os.path.getmtime(DROP_LIST) < LIST_TTL:
        need_fetch = False
    if need_fetch:
        text = fetch(DROP_URL, 20)
        if text and "/" in text:
            try:
                with open(DROP_LIST, "w", encoding="utf-8") as fh:
                    fh.write(text)
            except Exception:
                pass
    try:
        with open(DROP_LIST, "r", encoding="utf-8", errors="replace") as fh:
            content = fh.read()
    except Exception:
        return "unavailable", None
    if "/" not in content:
        return "unavailable", None
    for line in content.splitlines():
        cidr = line.split(";")[0].strip()
        if "/" not in cidr:
            continue
        try:
            if addr in ipaddress.ip_network(cidr, strict=False):
                return "hit", cidr
        except Exception:
            continue
    return "clean", None


def parse_block(fmt, text):
    """把名单文本解析成 (精确IP集合, v4网段列表, v6网段列表, 附加信息)。"""
    exact, nets, meta = set(), [], {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line[0] in "#;":
            continue
        if fmt == "score":
            parts = line.replace("\t", " ").split()
            if len(parts) < 2:
                continue
            try:
                score = int(parts[1])
            except Exception:
                continue
            if score < IPSUM_MIN:
                continue
            exact.add(parts[0])
            meta[parts[0]] = score
            continue
        if fmt == "dshield":
            parts = line.split()
            if len(parts) < 3:
                continue
            try:
                nets.append(ipaddress.ip_network("%s/%s" % (parts[0], parts[2]),
                                                 strict=False))
            except Exception:
                pass
            continue
        token = line.split(";")[0].strip()
        if not token:
            continue
        token = token.split()[0]
        if "/" in token:
            try:
                nets.append(ipaddress.ip_network(token, strict=False))
            except Exception:
                pass
        else:
            try:
                ipaddress.ip_address(token)
            except Exception:
                continue
            exact.add(token)
    v4, v6 = [], []
    for net in nets:
        (v4 if net.version == 4 else v6).append(net)
    return exact, v4, v6, meta


def load_block(name, url, fmt):
    """带 12 小时本地缓存的名单加载；失败返回 None。"""
    if not os.path.isdir(BL_DIR):
        try:
            os.makedirs(BL_DIR)
        except Exception:
            pass
    safe = re.sub(r"[^A-Za-z0-9]+", "_", name).strip("_").lower()
    path = os.path.join(BL_DIR, "%s.json" % safe)
    if os.path.exists(path) and time.time() - os.path.getmtime(path) < BL_TTL:
        try:
            with open(path, "r", encoding="utf-8") as fh:
                d = json.load(fh)
            return (set(d.get("exact") or []),
                    [ipaddress.ip_network(n) for n in d.get("v4") or []],
                    [ipaddress.ip_network(n) for n in d.get("v6") or []],
                    d.get("meta") or {})
        except Exception:
            pass
    text = fetch(url, 35)
    if not text.strip():
        return None
    exact, v4, v6, meta = parse_block(fmt, text)
    if not exact and not v4 and not v6:
        return None
    try:
        with open(path, "w", encoding="utf-8") as fh:
            json.dump({"exact": sorted(exact),
                       "v4": [str(n) for n in v4],
                       "v6": [str(n) for n in v6],
                       "meta": meta}, fh)
    except Exception:
        pass
    return exact, v4, v6, meta


def probe_block(entry, ip_str, addr):
    name, url, fmt, cat = entry
    loaded = load_block(name, url, fmt)
    if not loaded:
        return {"name": name, "cat": cat, "state": "unavailable"}
    exact, v4, v6, meta = loaded
    if ip_str in exact:
        return {"name": name, "cat": cat, "state": "hit",
                "detail": meta.get(ip_str), "kind": "精确 IP"}
    nets = v4 if addr.version == 4 else v6
    for net in nets:
        if addr in net:
            return {"name": name, "cat": cat, "state": "hit",
                    "detail": str(net), "kind": "网段"}
    return {"name": name, "cat": cat, "state": "clean"}


def scan_blocks(ip, jobs=8):
    """并发匹配全部静态名单。"""
    try:
        addr = ipaddress.ip_address(ip)
    except Exception:
        return []
    ip_str = str(addr)
    with ThreadPoolExecutor(max_workers=jobs) as pool:
        results = list(pool.map(lambda e: probe_block(e, ip_str, addr), BL_LISTS))
    return results


PROXY_PORTS = {1080, 1081, 3128, 8080, 8118, 8888, 8388, 9050, 9150, 7890, 7891}
def intel_shodan(ip):
    raw = fetch("https://internetdb.shodan.io/%s" % ip, 15)
    if not raw.strip():
        return {"name": "Shodan", "note": "请求失败"}
    try:
        d = json.loads(raw)
    except Exception:
        return {"name": "Shodan", "note": "响应异常"}
    if d.get("detail"):
        return {"name": "Shodan", "note": "无扫描记录（未索引到开放服务）"}
    ports = d.get("ports") or []
    tags = [t for t in (d.get("tags") or []) if t]
    vulns = d.get("vulns") or []
    bad = [p for p in ports if p in PROXY_PORTS]
    warn = bool(bad) or bool(set(tags) & {"vpn", "tor", "proxy"}) or bool(vulns)
    bits = ["端口 %s" % (",".join(map(str, ports)) if ports else "无")]
    if tags:
        bits.append("标签 %s" % ",".join(tags))
    if bad:
        bits.append("⚠含代理常见端口 %s" % ",".join(map(str, bad)))
    if vulns:
        bits.append("⚠漏洞 %d 个" % len(vulns))
    return {"name": "Shodan", "note": " | ".join(bits), "warn": warn,
            "_ports": ports, "_tags": tags, "_vulns": vulns}


