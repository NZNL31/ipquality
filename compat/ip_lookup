def src_greynoise(ip):
    """GreyNoise Community：免费无 key，反映「是否被观测到主动扫描」。

    免 key 额度是 25 次/周，很容易打满，所以成功结果缓存 24 小时，
    避免重复查询同一个 IP 反复消耗配额。
    """
    cache = _gn_cache()
    entry = cache.get(ip)
    d = None
    if entry and time.time() - entry.get("t", 0) < GN_TTL:
        d = entry.get("d") or {}
    else:
        d = fetch_json("https://api.greynoise.io/v3/community/%s" % ip, 15)
        if d and "message" not in d:
            cache[ip] = {"t": time.time(), "d": d}
            _gn_cache(read=False, data=cache)
        elif d and "message" in d:
            return {"name": "GreyNoise", "proxy": None, "vpn": None, "tor": None,
                    "hosting": None, "mobile": None, "score": None,
                    "_err": "免费额度 25 次/周已用尽"}
    if not d:
        return {"name": "GreyNoise", "proxy": None, "vpn": None, "tor": None,
                "hosting": None, "mobile": None, "score": None,
                "_err": "接口无响应"}
    return {
        "name": "GreyNoise", "proxy": None, "vpn": None, "tor": None,
        "hosting": None, "mobile": None, "score": None,
        "_noise": d.get("noise"), "_riot": d.get("riot"),
