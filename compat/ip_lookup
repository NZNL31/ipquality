                 intel_sans, intel_otx, intel_virustotal, intel_pdns]
    with ThreadPoolExecutor(max_workers=8) as pool:
        for item in pool.map(lambda fn: fn(ip), intel_fns):
            if item:
                intel.append(item)

    blocks = [] if "--no-blocks" in argv else scan_blocks(ip)

    # 地理/归属：取第一个有效值
    geo = ("—", "—", "—")
    org = "—"
    ptr = None
    for src in results:
        g = src.get("_geo")
        if g and g[0] and geo[0] == "—":
            geo = tuple(x or "—" for x in g)
        if org == "—" and src.get("_org"):
            org = str(src["_org"])
        if not ptr and src.get("_ptr"):
            ptr = src["_ptr"]
    if org == "—":
        info = fetch_json("https://ipinfo.io/%s/json" % ip)
        org = info.get("org") or "—"
        if geo[0] == "—" and info.get("country"):
            geo = (info.get("country"), info.get("region") or "—",
                   info.get("city") or "—")
        ptr = ptr or info.get("hostname")

    dnsbl = None
    if is_v6:
        dnsbl = {"skipped": "IPv6 不适用（官方库仅支持 IPv4 反查）"}
    elif skip_dnsbl:
        dnsbl = {"skipped": "已跳过（--no-dnsbl）"}
    else:
        zones = load_zones()
        dnsbl = dnsbl_report(ip, zones) if zones else {"error": "列表下载失败"}

    score = None
    try:
        score = ipscore.evaluate(ip, org, ptr, results, intel, dnsbl, blocks)
    except Exception as exc:                       # 评分失败不能拖垮整份报告
        score = {"error": str(exc)}

    platforms = None
    if score and "severity" in score:
        try:
            platforms = iprisk.assess(score["severity"], score["dimensions"])
        except Exception:
            platforms = None

    # 实测放最后：要额外几十秒，而且必须拿到真实出口才有意义
    probe = ipprobe.run(ip, proxy) if proxy else None

    payload = {
        "ip": ip,
        "org": org,
        "country": geo[0], "region": geo[1], "city": geo[2],
        "ptr": ptr,
        "score": score,
        "platforms": platforms,
        "probe": probe,
        "sources": [{k: v for k, v in s.items() if not k.startswith("_")}
                    for s in results],
        "dnsbl": dnsbl,
        "blocks": blocks,
        "intel": [{k: v for k, v in i.items() if not k.startswith("_")}
                  for i in intel],
        "missing_key_sources": [k for k, v in KEYS.items() if not v],
    }

    if as_json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0

    if "--brief" in argv:
        if score and "score" in score:
            print("%s  %3d/%s %-4s 置信度%3d%%  %s"
                  % (pad(ip, 16), score["score"], score["grade"],
                     score["grade_cn"], score["confidence"], score["verdict"]))
        else:
            print("%s  评分失败：%s" % (pad(ip, 16), (score or {}).get("error")))
        return 0

    # ---- 文本报告
    print("IP 质量速查：%s" % ip)
    print("=" * 68)
    print("      %s   %s" % (pad("归属", 10), org))
    print("      %s   %s / %s / %s" % (pad("位置", 10), geo[0], geo[1], geo[2]))
    if ptr:
        print("      %s   %s" % (pad("反向解析", 10), ptr))

    if score and "score" in score:
        _print_score(score)
    elif score:
        print()
        print("【综合评分】 计算失败：%s" % score.get("error"))

    if platforms:
        _print_platforms(platforms)

    judged = [s for s in results
              if s.get("proxy") is not None or s.get("tor") is not None
              or s.get("score") is not None]
    print()
    print("【风险因子交叉比对】%d 个库" % len(results))
    print("  " + pad("库", 16) + pad("代理/VPN", 10) + pad("类型", 14)
          + pad("Tor", 5) + pad("机房", 5) + pad("移动", 6) + pad("扫描", 6)
          + "评分")
    print("  " + "-" * 74)
    for s in results:
        sc = "—"
        if s.get("score") is not None:
            sc = "%s" % s["score"]
            if s.get("_abuse") is True:
                sc += " ⚑滥用"
            elif s.get("_reports"):
                sc += " (%s报)" % s["_reports"]
        if s.get("_err"):
            scan = "限流"
        elif s.get("_riot") is True:
            scan = "良性"
        elif s.get("_noise") is not None:
            scan = tri(s.get("_noise"))
        else:
            scan = "—"
        print("  " + pad(s["name"][:16], 16) + pad(tri(s.get("proxy")), 10)
              + pad((s.get("_rtype") or "—")[:14], 14)
              + pad(tri(s.get("tor")), 5) + pad(tri(s.get("hosting")), 5)
              + pad(tri(s.get("mobile")), 6) + pad(scan, 6) + sc)

    gaps = [s for s in results if s.get("_err")]
    if gaps:
        print("  数据缺口：%s —— 该项不计分，只降低置信度"
              % "；".join("%s %s" % (g["name"], g["_err"]) for g in gaps))

    proxy_votes = [s for s in results if s.get("proxy") is True]
    tor_votes = [s for s in results if s.get("tor") is True]
    datacenter_votes = [s for s in results if s.get("hosting") is True]
    voters = [s for s in results if s.get("proxy") is not None]

    print()
    if proxy_votes:
        detail = "、".join(s["name"] + ((" " + s["_rtype"]) if s.get("_rtype") else "")
                          for s in proxy_votes)
        print("代理判定：  ⚠ %d/%d 个库判定为代理 —— %s"
              % (len(proxy_votes), len(voters), detail))
    elif voters:
        print("代理判定：  否（%d 个库一致判定非代理）" % len(voters))
    else:
        print("代理判定：  —（无可用判定源）")
    if tor_votes:
        print("Tor：       ⚠ %d 个库判定为 Tor 出口" % len(tor_votes))
    if datacenter_votes:
        print("机房 IP：   ⚠ %d 个库判定为数据中心/托管段" % len(datacenter_votes))

    vt = next((i for i in intel if i["name"] == "VirusTotal"), None)
    if vt and vt.get("_tags"):
        flagged_tags = [t for t in vt["_tags"]
                        if t in ("vpn", "proxy", "tor", "anonymous",
                                 "exit-node", "c2", "malware", "phishing")]
        if flagged_tags:
            print("VT 标签：   ⚠ %s（语料库类别标签，独立于引擎判定）"
                  % "、".join(flagged_tags))

    gn = next((s for s in results if s["name"] == "GreyNoise"), None)
    if gn and gn.get("_noise") is True:
        print("主动行为：  ⚠ GreyNoise 观测到主动扫描（分类 %s，最近 %s）"
              % (gn.get("_class") or "unknown", gn.get("_last") or "未知"))
    elif gn and gn.get("_riot") is True:
        print("主动行为：  良性服务（GreyNoise RIOT，公共 DNS/CDN 类）")
    elif gn and gn.get("_noise") is False:
        print("主动行为：  未观测到扫描行为（GreyNoise 无记录）")

    if "skipped" in dnsbl:
        print("黑名单：    %s" % dnsbl["skipped"])
    elif "error" in dnsbl:
        print("黑名单：    %s" % dnsbl["error"])
    else:
        print("黑名单：    %d 库 | 正常 %d | 已标记 %d | 黑名单 %d"
              % (dnsbl["total"], dnsbl["clean"], dnsbl["other"],
                 dnsbl["blacklisted"]))
        if dnsbl.get("suspect"):
            print("            （另有 %d 条疑似误报已剔除：该库对 8.8.8.8/1.1.1.1 同样命中）"
                  % dnsbl["suspect"])
        for hit in dnsbl.get("hits", [])[:8]:
            if hit.get("suspect"):
                tag = "疑似误报"
            else:
                tag = "黑名单" if hit["verdict"] == "blacklisted" else "已标记"
            print("            · %-30s %s -> %s"
                  % (hit["zone"], tag, ",".join(hit["answer"])))

    if blocks:
        hits = [b for b in blocks if b["state"] == "hit"]
        down = [b for b in blocks if b["state"] == "unavailable"]
        cat_cn = {"blacklist": "恶意/滥用", "proxy": "代理段",
                  "tor": "Tor 出口", "cloud": "机房段"}
        print("静态名单：  %d 个（本地缓存，不耗 API 额度）" % len(blocks))
        if hits:
            for b in hits:
                extra = ""
                if b.get("detail") is not None:
                    if b["name"] == "IPsum":
                        extra = "被 %s 个黑名单收录" % b["detail"]
                    else:
                        extra = "%s %s" % (b.get("kind") or "", b["detail"])
                else:
                    extra = {"tor": "在 Tor 官方出口名单中",
                             "proxy": "在代理/VPN 精确列表中",
                             "cloud": "在机房精确列表中"}.get(
                                 b["cat"], "精确 IP 命中")
                print("            ⚠ %s %s" % (pad(b["name"][:15], 17),
                                              extra.strip()))
        else:
            print("            未命中任何名单")
        parts = []
        for cat in ("blacklist", "proxy", "tor", "cloud"):
            members = [b for b in blocks if b["cat"] == cat]
            if not members:
                continue
            hit = sum(1 for b in members if b["state"] == "hit")
            parts.append("%s %d/%d" % (cat_cn[cat], hit, len(members)))
        print("            分类命中：%s" % " | ".join(parts))
        if down:
            print("            不可用：%s" % "、".join(b["name"] for b in down))

    print()
    keyed = 1 if any(i["name"] == "VirusTotal" for i in intel) else 0
    print("【威胁情报】%d 源（记录事实型口径%s）"
          % (len(intel), "，含 VirusTotal" if keyed else "，全部免 key"))
    for item in intel:
        print("  %s%s %s" % ("⚠ " if item.get("warn") else "  ",
                             pad(item["name"][:15], 15), item.get("note", "")))

    pd = next((i for i in intel if i.get("name") == "PassiveDNS"), None)
    if pd and "_recent" in pd:
        total_all = pd.get("_total") or 0
        recent = pd.get("_recent") or 0
        mal = pd.get("_mal_hosts") or []
        print()
        print("【出口复用】近期有多少服务共用这个出口")
        if not recent and not total_all:
            print("  独享出口 —— 没有域名解析到此，信誉只由自身行为决定")
        else:
            if total_all >= 100:
                level = "高密度共享（CDN / 虚拟主机 / 多用户出口）"
            elif total_all >= 20:
                level = "共享出口"
            elif total_all >= 1:
                level = "轻度共享"
            else:
                level = "基本独享"
            print("  解析记录累计 %d 条｜近 90 天活跃样本 %d 个 —— 判读：%s"
                  % (total_all, recent, level))
            if total_all > 40:
                print("  （免费层每次返回前 40 条，总数以 VT 累计为准）")
            if mal:
                print("  ⚠ 共用域名中被引擎判恶意的 %d 个：%s%s"
                      % (len(mal), "、".join(mal[:3]),
                         "…" if len(mal) > 3 else ""))
                print("    同出口邻居作恶会连累整段出口的风控评级（连坐效应）")

    if score and "usecases" in score:
        _print_usecases(score["usecases"])

    missing = [k for k in payload["missing_key_sources"]
               if k in ("ipqualityscore", "abuseipdb", "virustotal")]
    if missing:
        print()
        print("未启用（缺免费 key，可补）：%s  —— 运行 ip_lookup --keys 查看获取方式"
              % "、".join(missing))
    if any(s["name"] == "IPQualityScore" for s in results):
        print()
        print("注：IPQS 免费层不含住宅代理检测与 connection_type（需 SMB+ 付费档），")
        print("    其「代理=否」对住宅代理/住宅 SS 节点的证伪力有限。")

    if probe:
        _print_probe(ip, probe, platforms)

    print("=" * 68)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
