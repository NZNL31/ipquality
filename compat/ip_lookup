            parts.append("%s（%s）" % (reason, head))
        print("  卡点：%s" % "；".join(parts))
    print("  最严：%s ｜ 最松：%s" % (data["strictest"], data["loosest"]))
    print("  档位：通过 ≥85 ｜ 观察 ≥72 ｜ 挑战 ≥55 ｜ 拒绝 <55"
          "（平台无公开查询接口，按已知敏感项加权推断）")


