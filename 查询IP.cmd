@echo off
rem ============================================================
rem  ??IP.cmd -- ????????? IP ??????
rem  ?????????:  ??IP.cmd 1.2.3.4
rem ============================================================
chcp 65001 >nul 2>&1
setlocal
title IP 质量查询

rem 带参数：单次查询模式，不进入交互循环
if not "%~1"=="" (
  call "%~dp0ipq.cmd" %*
  goto :done
)

:loop
cls
echo ==============================================================
echo   IP 质量查询   评分 / 平台风控 / 黑名单 / 出口复用 一站式
echo ==============================================================
echo   支持任意公网 IPv4 / IPv6，例如 126.27.114.219
echo   加参数可省步骤，如输入: 1.2.3.4 --no-dnsbl  (跳过423库反查)
echo   直接回车退出
echo --------------------------------------------------------------
set "ip="
set /p "ip=请输入要查询的 IP: "
if not defined ip goto :eof
if /i "%ip%"=="q" goto :eof
if /i "%ip%"=="exit" goto :eof

call "%~dp0ipq.cmd" %ip%
echo(
echo ==============================================================
echo   查询完成。可继续输入下一个 IP，直接回车退出。
echo ==============================================================
pause
goto :loop

:done
endlocal
